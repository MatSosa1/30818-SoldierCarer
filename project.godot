; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SoldierCarer"
run/main_scene="uid://bmorjhsg5xpq2"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

EventBus="*res://scripts/Autoloads/event_bus.gd"
GestorAudio="*res://scripts/Autoloads/gestor_audio.gd"
GestorOpciones="*res://scripts/Autoloads/gestor_opciones.gd"
GestorJuego="*res://scripts/Autoloads/gestor_juego.gd"

[dotnet]

project/assembly_name="SoldierCarer"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[xr]

openxr/enabled=true
